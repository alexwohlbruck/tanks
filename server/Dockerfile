# Built from the repo root: docker build -f server/Dockerfile .
FROM oven/bun:1-alpine
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --production --frozen-lockfile || bun install --production
COPY src ./src
COPY server ./server
# game data the server-side simulation needs (generated by tools/build_data.py)
COPY public/assets/data ./public/assets/data
ENV PORT=3001 DATA_DIR=/data
EXPOSE 3001
CMD ["bun", "server/index.ts"]
